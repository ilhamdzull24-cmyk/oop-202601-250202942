sequenceDiagram
    actor U as Peminjam
    participant P as Peminjaman
    participant J as JadwalPeminjaman
    participant A as Aset

    U->>P: new Peminjaman(id, peminjam, aset, mulai, selesai)
    P-->>U: peminjaman (status DIAJUKAN)
    U->>J: ajukan(baru)
    J->>J: bentrok(baru)

    alt Skenario bentrok: aset sama dan waktu tumpang tindih
        J-->>U: throw PeminjamanBentrokException
    else Tidak bentrok
        J->>A: getJenis()
        A-->>J: JenisAset

        alt Jenis LAPTOP dan laptop aktif peminjam >= kuotaLaptop
            J-->>U: throw KuotaHabisException
        else Skenario sukses
            J->>J: tambah(baru)
            J-->>U: selesai (peminjaman tercatat)
        end
    end
